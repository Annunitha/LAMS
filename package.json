    "leaflet": "^1.9.4",
    "lucide-react": "latest",
    "mysql2": "^3.14.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vite": "latest"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.18",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "~5.8.3"
  }
}